{
  "name": "@rata/tokens",
  "version": "0.1.0",
  "type": "module",
  "description": "Design tokens: single JSON source of truth, built to CSS variables, TypeScript, and a Tailwind preset.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/css/tokens.css",
    "./tailwind": "./dist/tailwind/preset.cjs",
    "./usage": "./dist/usage.json",
    "./theme": "./src/theme/index.mjs",
    "./theme/base": "./src/themes/base.mjs"
  },
  "files": [
    "dist",
    "TOKENS.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "docs:check": "node build.mjs --check"
  }
}
